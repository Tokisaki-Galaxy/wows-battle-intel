<Window x:Class="WowsBattleIntel.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="wows-battle-intel · 战斗情报与胜负预测"
        Height="800" Width="1440"
        MinHeight="600" MinWidth="1360"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">

  <Window.Resources>
    <!-- 列表项模板：两行信息加右侧胶囊结果徽章，选中指示条由 ListBoxItem 样式提供 -->
    <DataTemplate x:Key="BattleItemTemplate">
      <Grid Margin="4,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DisplayText}"
                       Style="{StaticResource BodyTextStyle}"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding TierText}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding SecondaryText}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="0,3,0,0" />
          <TextBlock Text="{Binding PredictionText}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Foreground="{StaticResource PrimaryFgBrush}"
                     Margin="0,2,0,0" />
        </StackPanel>

        <!-- 右侧结果徽章：胶囊形，柔底加同族描边加同色文字三件套 -->
        <Border Grid.Column="1"
                Style="{StaticResource BadgeBorderStyle}"
                Background="{Binding ResultBrushKey, Converter={StaticResource BrushKeyConverter}, ConverterParameter=soft}"
                BorderBrush="{Binding ResultBrushKey, Converter={StaticResource BrushKeyConverter}, ConverterParameter=bd}"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding ResultLabel}"
                     Style="{StaticResource BadgeTextStyle}">
            <TextBlock.Foreground>
              <Binding Path="ResultBrushKey" Converter="{StaticResource BrushKeyConverter}" />
            </TextBlock.Foreground>
          </TextBlock>
        </Border>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="{StaticResource SpacingLg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <TextBlock Text="战斗情报" Style="{StaticResource BrandTextStyle}" />
        <Border Style="{StaticResource BadgeBorderStyle}"
                Background="{StaticResource PrimarySoftBrush}"
                BorderBrush="{StaticResource PrimaryBdBrush}"
                Margin="12,0,0,0">
          <TextBlock Text="{Binding ModelVersionText}"
                     Style="{StaticResource BadgeTextStyle}"
                     Foreground="{StaticResource PrimaryFgBrush}" />
        </Border>
      </StackPanel>

      <TextBlock Grid.Column="1"
                 Text="{Binding PredictorStatusText}"
                 Style="{StaticResource SecondaryTextStyle}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="16,0"
                 TextTrimming="CharacterEllipsis" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding ObservationStatusText}"
                   Style="{StaticResource SecondaryTextStyle}"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0" />
        <Button Content="{Binding ObservationButtonText}"
                Command="{Binding ToggleObservationCommand}" />
        <Button Content="刷新列表" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>

    <!-- 主标签页 -->
    <TabControl Grid.Row="1">

      <!-- 对局情报 -->
      <TabItem Header="对局情报">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 左栏：对局列表，按实时与历史分区 -->
          <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="对局记录"
                         Style="{StaticResource HeadingTextStyle}"
                         Margin="{StaticResource SpacingSm}" />

              <!-- 实时对局区：观测会话内入库，主色左边条标记 -->
              <StackPanel DockPanel.Dock="Top" Margin="{StaticResource SpacingSm}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Border Width="3"
                          Height="12"
                          CornerRadius="1"
                          Background="{StaticResource PrimaryBrush}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="实时对局"
                             Style="{StaticResource SecondaryTextStyle}"
                             Foreground="{StaticResource PrimaryFgBrush}"
                             FontWeight="SemiBold"
                             Margin="6,0,0,0" />
                </StackPanel>
                <ListBox x:Name="LiveBattlesList"
                         ItemsSource="{Binding LiveBattles}"
                         SelectedItem="{Binding SelectedBattleSummary}"
                         ItemTemplate="{StaticResource BattleItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MaxHeight="220"
                         Visibility="{Binding HasLiveBattles, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="暂无实时对局，开启观测后入库的对局会出现在这里"
                           Style="{StaticResource EmptyHintTextStyle}"
                           Margin="0,2,0,0"
                           Visibility="{Binding HasLiveBattles, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
              </StackPanel>

              <!-- 分隔线：发丝线 -->
              <Border DockPanel.Dock="Top"
                      Height="1"
                      Background="{StaticResource HairlineBrush}"
                      Margin="{StaticResource SpacingSm}" />

              <!-- 历史对局区 -->
              <StackPanel DockPanel.Dock="Top" Margin="{StaticResource SpacingSm}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Border Width="3"
                          Height="12"
                          CornerRadius="1"
                          Background="{StaticResource HiddenBrush}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="历史对局"
                             Style="{StaticResource SecondaryTextStyle}"
                             Margin="6,0,0,0" />
                </StackPanel>
              </StackPanel>
              <ListBox ItemsSource="{Binding HistoryBattles}"
                       SelectedItem="{Binding SelectedBattleSummary}"
                       ItemTemplate="{StaticResource BattleItemTemplate}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
          </Border>

          <!-- 右栏 -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 预测对照仪表 -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
              <StackPanel Margin="{StaticResource SpacingLg}">

                <!-- 大号胜率读数与概率条 -->
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding PredictedWinrateText}"
                             Style="{StaticResource DisplayTextStyle}"
                             Foreground="{StaticResource AllyBrush}" />
                  <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="友方预测胜率"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding EnemyWinrateText}"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource EnemyBrush}"
                               Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="对照结果"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding PredictionVerdict}"
                               Style="{StaticResource HeadingTextStyle}"
                               Margin="0,2,0,0" />
                  </StackPanel>
                </StackPanel>

                <!-- 概率条：友方蓝与敌方红按预测概率分割，分割线即五五开 -->
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding AllyProbabilityRatio, Converter={StaticResource ProbabilityToGridLengthConverter}}" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Height="10" CornerRadius="5,0,0,5"
                          Background="{StaticResource AllyBrush}" />
                  <Border Grid.Column="1" Height="10" CornerRadius="0,5,5,0"
                          Background="{StaticResource EnemyBrush}" />
                </Grid>

                <!-- 双指标拆分：覆盖率与模型置信度分开读 -->
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Style="{StaticResource InsetPanelStyle}" Padding="10,8">
                    <StackPanel>
                      <TextBlock Text="数据完整度"
                                 Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Text="{Binding DataCoverageText}"
                                 Style="{StaticResource HeadingTextStyle}"
                                 Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Style="{StaticResource InsetPanelStyle}" Padding="10,8">
                    <StackPanel>
                      <TextBlock Text="模型置信度"
                                 Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Text="{Binding ModelConfidenceText}"
                                 Style="{StaticResource HeadingTextStyle}"
                                 Foreground="{StaticResource PrimaryFgBrush}"
                                 Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="4" Style="{StaticResource InsetPanelStyle}" Padding="10,8">
                    <StackPanel>
                      <TextBlock Text="局势评估"
                                 Style="{StaticResource SecondaryTextStyle}" />
                      <TextBlock Text="{Binding TierText}"
                                 Style="{StaticResource HeadingTextStyle}"
                                 Foreground="{Binding TierBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                 Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- 副标题单独一行，避免挤占指标卡宽度 -->
                <TextBlock Text="{Binding BattleSubtitle}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
              </StackPanel>
            </Border>

            <!-- 双方名单：阵营色顶边条 + 底部对照 -->
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- 友方 -->
              <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Height="3"
                          Background="{StaticResource AllyBrush}"
                          CornerRadius="16,16,0,0" />
                  <DockPanel Grid.Row="1">
                    <!-- 队名与平均数据同一行，ApeRadar 式头部 -->
                    <Grid DockPanel.Dock="Top" Margin="{StaticResource SpacingSm}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="友方"
                                 Style="{StaticResource HeadingTextStyle}"
                                 Foreground="{StaticResource AllyBrush}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                        <TextBlock Text="平均数据: "
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding AllySummaryText}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Allies}">
                      <DataGrid.Resources>
                        <!-- 行背景按水平分档：海王紫底、猴子红底，普通透明 -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                          <Setter Property="Background"
                                  Value="{Binding Converter={StaticResource RowBackgroundBrushKeyConverter}}" />
                        </Style>
                      </DataGrid.Resources>
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="玩家" Width="*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding PlayerLineText}"
                                             Style="{StaticResource BodyTextStyle}" />
                                  <Border VerticalAlignment="Top" Margin="3,1,0,0"
                                          Width="8" Height="8" CornerRadius="2"
                                          ToolTip="小队"
                                          Background="{Binding DivisionSize, Converter={StaticResource DivisionBadgeBrushConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ShipLineText}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="账号" Width="Auto">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding BattlesBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding WinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding WinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding AvgDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding AvgDamageBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="加权" Width="Auto">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding WeightedWinrateText}"
                                         Style="{StaticResource BodyTextStyle}"
                                         Foreground="{Binding WeightedWinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="单船" Width="Auto">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ShipBattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ShipWinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ShipWinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ShipDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ShipDamageBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Grid>
              </Border>

              <!-- 敌方 -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Height="3"
                          Background="{StaticResource EnemyBrush}"
                          CornerRadius="16,16,0,0" />
                  <DockPanel Grid.Row="1">
                    <!-- 队名与平均数据同一行，ApeRadar 式头部 -->
                    <Grid DockPanel.Dock="Top" Margin="{StaticResource SpacingSm}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="敌方"
                                 Style="{StaticResource HeadingTextStyle}"
                                 Foreground="{StaticResource EnemyBrush}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                        <TextBlock Text="平均数据: "
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding EnemySummaryText}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Enemies}">
                      <DataGrid.Resources>
                        <!-- 行背景按水平分档：与友方同一套样式 -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                          <Setter Property="Background"
                                  Value="{Binding Converter={StaticResource RowBackgroundBrushKeyConverter}}" />
                        </Style>
                      </DataGrid.Resources>
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="玩家" Width="*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding PlayerLineText}"
                                             Style="{StaticResource BodyTextStyle}" />
                                  <Border VerticalAlignment="Top" Margin="3,1,0,0"
                                          Width="8" Height="8" CornerRadius="2"
                                          ToolTip="小队"
                                          Background="{Binding DivisionSize, Converter={StaticResource DivisionBadgeBrushConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ShipLineText}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="账号" Width="Auto">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding BattlesBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding WinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding WinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding AvgDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding AvgDamageBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="加权" Width="Auto">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding WeightedWinrateText}"
                                         Style="{StaticResource BodyTextStyle}"
                                         Foreground="{Binding WeightedWinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="单船" Width="Auto">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ShipBattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ShipWinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ShipWinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ShipDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ShipDamageBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- 校准统计 -->
      <TabItem Header="校准统计">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel DataContext="{Binding Calibration}">

            <!-- 指标卡 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
                <StackPanel>
                  <TextBlock Text="Brier 分数" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Text="{Binding BrierScoreText}"
                             Style="{StaticResource TitleTextStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock Text="{Binding BrierComparisonText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
                <StackPanel>
                  <TextBlock Text="对数损失" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Text="{Binding LogLossText}"
                             Style="{StaticResource TitleTextStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock Text="{Binding LogLossComparisonText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
                <StackPanel>
                  <TextBlock Text="判别准确率" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Text="{Binding AccuracyText}"
                             Style="{StaticResource TitleTextStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock Text="预测方向与结果一致的比例"
                             Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
                <StackPanel>
                  <TextBlock Text="样本规模" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Text="{Binding SampleCount}"
                             Style="{StaticResource TitleTextStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock Text="{Binding SampleCountText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- 结论与刷新 -->
            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingSm}" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding QualityText}"
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="重新统计"
                        Command="{Binding RefreshCommand}" />
              </Grid>
            </Border>

            <!-- 校准曲线 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="校准曲线"
                           Style="{StaticResource HeadingTextStyle}"
                           Margin="{StaticResource SpacingSm}" />
                <TextBlock DockPanel.Dock="Top"
                           Text="柱长代表该概率区间的实际胜率，与预测均值越接近越好。柱为红色表示偏差超过 0.1。"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="8,0,8,8"
                           TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Buckets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="70" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding RangeText}"
                                   Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center" />

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                          <Border Height="18"
                                  Width="{Binding BarWidth}"
                                  HorizontalAlignment="Left"
                                  CornerRadius="3"
                                  Background="{Binding BarBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="样本 " Style="{StaticResource SecondaryTextStyle}" />
                          <TextBlock Text="{Binding SampleCountText}"
                                     Style="{StaticResource SecondaryTextStyle}"
                                     Width="46"
                                     TextAlignment="Right" />
                          <TextBlock Text="  实际 " Style="{StaticResource SecondaryTextStyle}" />
                          <TextBlock Text="{Binding ActualWinrateText}"
                                     Style="{StaticResource SecondaryTextStyle}"
                                     Width="52"
                                     TextAlignment="Right" />
                          <TextBlock Text="  预测 " Style="{StaticResource SecondaryTextStyle}" />
                          <TextBlock Text="{Binding PredictedMeanText}"
                                     Style="{StaticResource SecondaryTextStyle}"
                                     Width="46"
                                     TextAlignment="Right" />
                          <TextBlock Text="  偏差 " Style="{StaticResource SecondaryTextStyle}" />
                          <TextBlock Text="{Binding CalibrationErrorText}"
                                     Style="{StaticResource SecondaryTextStyle}"
                                     Width="60"
                                     TextAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="4,8,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 设置 -->
      <TabItem Header="设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel DataContext="{Binding Settings}" MaxWidth="900" HorizontalAlignment="Left">

            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
              <StackPanel>
                <TextBlock Text="路径配置" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,4" />
                <TextBlock Text="路径在启动时被各服务读取，修改后需保存才会生效。"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏目录"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,8,8" />
                  <Button Grid.Row="0" Grid.Column="2" Content="浏览"
                          Command="{Binding BrowseGamePathCommand}" Margin="0,0,0,8" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="数据库路径"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,8,8" />
                  <Button Grid.Row="1" Grid.Column="2" Content="浏览"
                          Command="{Binding BrowseDatabasePathCommand}" Margin="0,0,0,8" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="replayshark"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReplaysharkPath, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,8,8" />
                  <Button Grid.Row="2" Grid.Column="2" Content="浏览"
                          Command="{Binding BrowseReplaysharkPathCommand}" Margin="0,0,0,8" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="游戏数据目录"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ExtractedDataPath, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,8,8" />
                  <Button Grid.Row="3" Grid.Column="2" Content="浏览"
                          Command="{Binding BrowseExtractedDataPathCommand}" Margin="0,0,0,8" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="constants 根目录"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ConstantsRootPath, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,8,8" />
                  <Button Grid.Row="4" Grid.Column="2" Content="浏览"
                          Command="{Binding BrowseConstantsRootPathCommand}" Margin="0,0,0,8" />

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="模型路径"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,8,0" />
                  <Button Grid.Row="5" Grid.Column="2" Content="浏览"
                          Command="{Binding BrowseModelPathCommand}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="外观" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,4" />
                <TextBlock Text="切换立即生效，保存后下次启动沿用。"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="主题"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox Grid.Row="0" Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                            SelectedIndex="{Binding ThemeIndex, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="模型与观测" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="模型版本"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="0" Grid.Column="1" MaxWidth="360" HorizontalAlignment="Left"
                           Text="{Binding ModelVersion, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,0,8" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="WG API 应用 ID"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="1" Grid.Column="1" MaxWidth="360" HorizontalAlignment="Left"
                           Text="{Binding WgApplicationId, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,0,8" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="轮询间隔秒"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Grid.Row="2" Grid.Column="1" MaxWidth="120" HorizontalAlignment="Left"
                           Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <CheckBox Content="启动时自动观测回放目录"
                          IsChecked="{Binding AutoObserve}"
                          Margin="0,12,0,0" />
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="保存并应用" Command="{Binding SaveCommand}" />
              <TextBlock Text="{Binding StatusMessage}"
                         Style="{StaticResource SecondaryTextStyle}"
                         VerticalAlignment="Center"
                         Margin="12,0,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- 状态栏 -->
    <StatusBar Grid.Row="2" Margin="0,12,0,0" Background="Transparent">
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}" />
      <ProgressBar IsIndeterminate="True"
                   Width="80"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center">
        <ProgressBar.Style>
          <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ProgressBar.Style>
      </ProgressBar>
    </StatusBar>
  </Grid>
</Window>
