{
  "name": "wows-battle-intel-edge",
  "version": "0.1.0",
  "private": true,
  "description": "中央协调库边缘后端：玩家统计缓存、对局采集、模型分发",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply wows-battle-intel --local",
    "db:migrate:remote": "wrangler d1 migrations apply wows-battle-intel --remote",
    "db:list": "wrangler d1 migrations list wows-battle-intel --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "vitest": "~2.1.0",
    "wrangler": "^4.151.0"
  }
}
