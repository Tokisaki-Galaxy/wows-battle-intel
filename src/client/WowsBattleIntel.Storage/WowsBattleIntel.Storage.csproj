<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Local persistence layer. SQLite implementation of the repository
    interfaces, plus schema management and bulk import.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WowsBattleIntel.Storage</RootNamespace>
    <AssemblyName>WowsBattleIntel.Storage</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- 显式引用以覆盖 Microsoft.Data.Sqlite 的传递依赖，修 GHSA-2m69-gcr7-jv3q。 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WowsBattleIntel.Core\WowsBattleIntel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\schema.sql" />
  </ItemGroup>

</Project>
