<Project>

  <!--
    Shared MSBuild properties for all projects in the repository.
    Keep version numbers and language settings here so they stay consistent.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      GenerateDocumentationFile enables the IDE0005 analyzer (unused usings).
      CS1591 (missing XML comment) is suppressed so internal types do not require docs.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>wows-battle-intel contributors</Authors>
    <Product>wows-battle-intel</Product>
    <Copyright>Copyright (c) wows-battle-intel contributors</Copyright>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
