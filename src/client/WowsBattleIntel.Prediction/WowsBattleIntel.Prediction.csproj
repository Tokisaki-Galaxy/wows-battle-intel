    feature extraction pipeline shared with the ML project.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WowsBattleIntel.Prediction</RootNamespace>
    <AssemblyName>WowsBattleIntel.Prediction</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WowsBattleIntel.Core\WowsBattleIntel.Core.csproj" />
  </ItemGroup>

</Project>
