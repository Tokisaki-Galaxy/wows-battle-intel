<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Replay parsing layer. Wraps replayshark as an external process and
    maps its output into the core domain model.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WowsBattleIntel.Replay</RootNamespace>
    <AssemblyName>WowsBattleIntel.Replay</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WowsBattleIntel.Core\WowsBattleIntel.Core.csproj" />
  </ItemGroup>

</Project>
