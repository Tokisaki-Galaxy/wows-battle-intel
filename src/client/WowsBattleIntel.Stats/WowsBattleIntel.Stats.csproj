<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Player statistics sources. Adapters for WG Public API and future
    providers, plus local caching layered on top.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WowsBattleIntel.Stats</RootNamespace>
    <AssemblyName>WowsBattleIntel.Stats</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      船名词典，数字 ship_id 到中文名。取自 ApeRadar（GPL）随包分发的
      ships.json，内容为游戏数据，代码许可不传染。以嵌入资源携带，
      与 Storage 项目的 schema.sql 同一处理方式。
    -->
    <EmbeddedResource Include="Resources\ships.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WowsBattleIntel.Core\WowsBattleIntel.Core.csproj" />
  </ItemGroup>

</Project>
