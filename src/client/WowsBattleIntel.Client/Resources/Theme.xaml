<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WowsBattleIntel.Client.Views.Converters">

  <!--
    主题装配层。画刷、文本样式与隐式控件样式全部引用主题字典里的令牌，
    本文件不出现具体色值与字号，保证令牌是唯一事实来源。
    兼容键保留：ViewModel 经 BrushKeyConverter 按字符串键名取画刷，测试断言这些键名。
    装配时先合并一份主题令牌字典（Tokens.Dark.xaml 或 Tokens.Light.xaml），
    再合并本文件，最后合并 Controls.Shared.xaml。
  -->

  <!-- 表面与边框画刷 -->
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
  <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceInsetBrush" Color="{StaticResource SurfaceInsetColor}" />
  <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="ControlBdBrush" Color="{StaticResource ControlBdColor}" />
  <SolidColorBrush x:Key="ControlBdHoverBrush" Color="{StaticResource ControlBdHoverColor}" />

  <!-- 文本画刷 -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

  <!-- 品牌与语义画刷 -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
  <SolidColorBrush x:Key="PrimaryFgBrush" Color="{StaticResource PrimaryFgColor}" />
  <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />
  <SolidColorBrush x:Key="PrimaryBdBrush" Color="{StaticResource PrimaryBdColor}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="NavSelectedBgBrush" Color="{StaticResource NavSelectedBgColor}" />
  <SolidColorBrush x:Key="NavSelectedFgBrush" Color="{StaticResource NavSelectedFgColor}" />

  <!-- 业务画刷：阵营、水平分档、结果。兼容键映射进新语义体系 -->
  <SolidColorBrush x:Key="AllyBrush" Color="{StaticResource AllyColor}" />
  <SolidColorBrush x:Key="EnemyBrush" Color="{StaticResource EnemyColor}" />
  <SolidColorBrush x:Key="UnicumBrush" Color="{StaticResource UnicumColor}" />
  <SolidColorBrush x:Key="ApeBrush" Color="{StaticResource ApeColor}" />
  <SolidColorBrush x:Key="HiddenBrush" Color="{StaticResource HiddenColor}" />
  <SolidColorBrush x:Key="WinBrush" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="LossBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource OkColor}" />
  <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource DangerColor}" />

  <!-- 舰种行底色画刷与通用透明画刷 -->
  <SolidColorBrush x:Key="RowCvBrush" Color="{StaticResource RowCvColor}" />
  <SolidColorBrush x:Key="RowBbBrush" Color="{StaticResource RowBbColor}" />
  <SolidColorBrush x:Key="RowCaBrush" Color="{StaticResource RowCaColor}" />
  <SolidColorBrush x:Key="RowDdBrush" Color="{StaticResource RowDdColor}" />
  <SolidColorBrush x:Key="RowSsBrush" Color="{StaticResource RowSsColor}" />
  <!-- 水平行底色画刷：海王紫、猴子红 -->
  <SolidColorBrush x:Key="RowUnicumBrush" Color="{StaticResource RowUnicumColor}" />
  <SolidColorBrush x:Key="RowApeBrush" Color="{StaticResource RowApeColor}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <!-- 徽章三件套画刷：实色、柔底、同族描边 -->
  <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}" />
  <SolidColorBrush x:Key="OkBdBrush" Color="{StaticResource OkBdColor}" />
  <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}" />
  <SolidColorBrush x:Key="WarnBdBrush" Color="{StaticResource WarnBdColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="DangerBdBrush" Color="{StaticResource DangerBdColor}" />
  <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />
  <SolidColorBrush x:Key="InfoBdBrush" Color="{StaticResource InfoBdColor}" />
  <SolidColorBrush x:Key="NeutralSoftBrush" Color="{StaticResource NeutralSoftColor}" />
  <SolidColorBrush x:Key="NeutralBdBrush" Color="{StaticResource NeutralBdColor}" />
  <SolidColorBrush x:Key="AllySoftBrush" Color="{StaticResource AllySoftColor}" />
  <SolidColorBrush x:Key="AllyBdBrush" Color="{StaticResource AllyBdColor}" />
  <SolidColorBrush x:Key="EnemySoftBrush" Color="{StaticResource EnemySoftColor}" />
  <SolidColorBrush x:Key="EnemyBdBrush" Color="{StaticResource EnemyBdColor}" />

  <!-- 卡片阴影与主按钮光晕 -->
  <DropShadowEffect x:Key="CardShadow" BlurRadius="26" ShadowDepth="10" Direction="270" Opacity="0.4" />
  <DropShadowEffect x:Key="PrimaryGlow" Color="{StaticResource PrimaryColor}" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />

  <!-- 文本样式 -->
  <Style x:Key="BrandTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBrand}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="TitleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizePanelTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizePanelTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
  </Style>

  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
  </Style>

  <Style x:Key="EmptyHintTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
  </Style>

  <!-- 转换器 -->
  <views:ResourceKeyToBrushConverter x:Key="BrushKeyConverter" />
  <views:RowBackgroundBrushKeyConverter x:Key="RowBackgroundBrushKeyConverter" />
  <views:DivisionBadgeBrushConverter x:Key="DivisionBadgeBrushConverter" />
  <views:LogLevelTextConverter x:Key="LogLevelTextConverter" />
  <views:LogLevelBrushKeyConverter x:Key="LogLevelBrushKeyConverter" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
  <views:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter" />
  <views:ProbabilityToGridLengthConverter x:Key="ProbabilityToGridLengthConverter" />

</ResourceDictionary>
