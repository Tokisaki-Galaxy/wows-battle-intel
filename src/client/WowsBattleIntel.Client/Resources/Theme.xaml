<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    主题资源。集中定义颜色、字号、间距，界面不写死具体值。
    配色偏深色，与游戏场景协调，减少长时间查看的视觉疲劳。
  -->

  <!-- 背景与表面 -->
  <Color x:Key="BackgroundColor">#FF1A1D21</Color>
  <Color x:Key="SurfaceColor">#FF23272E</Color>
  <Color x:Key="SurfaceAltColor">#FF2B3038</Color>
  <Color x:Key="BorderColor">#FF3A4048</Color>

  <!-- 文本 -->
  <Color x:Key="TextPrimaryColor">#FFE8EAED</Color>
  <Color x:Key="TextSecondaryColor">#FF9AA0A6</Color>
  <Color x:Key="TextDisabledColor">#FF5F6368</Color>

  <!-- 阵营与状态 -->
  <Color x:Key="AllyColor">#FF4C8BF5</Color>
  <Color x:Key="EnemyColor">#FFE85C5C</Color>
  <Color x:Key="UnicumColor">#FFE8B84C</Color>
  <Color x:Key="ApeColor">#FFB05CF0</Color>
  <Color x:Key="HiddenColor">#FF7A8088</Color>
  <Color x:Key="PositiveColor">#FF4CC38A</Color>
  <Color x:Key="NegativeColor">#FFE85C5C</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
  <SolidColorBrush x:Key="AllyBrush" Color="{StaticResource AllyColor}" />
  <SolidColorBrush x:Key="EnemyBrush" Color="{StaticResource EnemyColor}" />
  <SolidColorBrush x:Key="UnicumBrush" Color="{StaticResource UnicumColor}" />
  <SolidColorBrush x:Key="ApeBrush" Color="{StaticResource ApeColor}" />
  <SolidColorBrush x:Key="HiddenBrush" Color="{StaticResource HiddenColor}" />
  <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
  <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}" />

  <!-- 字号 -->
  <sys:Double x:Key="FontSizeTitle">20</sys:Double>
  <sys:Double x:Key="FontSizeHeading">16</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeSmall">11</sys:Double>

  <!-- 间距 -->
  <Thickness x:Key="PaddingSmall">4</Thickness>
  <Thickness x:Key="PaddingMedium">8</Thickness>
  <Thickness x:Key="PaddingLarge">16</Thickness>

  <!-- 常用文本样式 -->
  <Style x:Key="TitleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
  </Style>

  <!-- 基础控件样式 -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

</ResourceDictionary>
