<Window x:Class="WowsBattleIntel.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="wows-battle-intel · 战斗情报与胜负预测"
        Height="800" Width="1440"
        MinHeight="600" MinWidth="1360"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/WowsBattleIntel.Client;component/Resources/Images/AppIcon.png"
        Style="{StaticResource AppWindowStyle}">

  <Window.Resources>
    <!-- 列表项模板：两行信息加右侧结果列，选中指示条由 ListBoxItem 样式提供 -->
    <DataTemplate x:Key="BattleItemTemplate">
      <Grid Margin="4,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding DisplayText}"
                     Style="{StaticResource BodyTextStyle}"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding SecondaryText}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Margin="0,3,0,0" />
          <TextBlock Text="{Binding PredictionText}"
                     Style="{StaticResource SecondaryTextStyle}"
                     Foreground="{StaticResource PrimaryFgBrush}"
                     Margin="0,2,0,0" />
        </StackPanel>

        <!-- 右侧结果列：等级行与结果词。等级保持次要文本色不染色 -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding TierText}"
                     Style="{StaticResource SecondaryTextStyle}"
                     HorizontalAlignment="Right" />
          <TextBlock Text="{Binding ResultLabel}"
                     HorizontalAlignment="Right"
                     Margin="0,3,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HiddenBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ResultLabel}" Value="胜利">
                    <Setter Property="Foreground" Value="{StaticResource WinBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ResultLabel}" Value="失败">
                    <Setter Property="Foreground" Value="{StaticResource LossBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="{StaticResource SpacingMd}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 主标签页 -->
    <TabControl Grid.Row="0">
      <!-- 对局情报 -->
      <TabItem Header="对局情报">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 左栏：对局列表，按实时与历史分区，头部带观测与刷新按钮 -->
          <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="{StaticResource SpacingSm}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="对局记录"
                           Style="{StaticResource HeadingTextStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ObservationStatusText}"
                           Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" />
              </Grid>

              <!-- 当前对局区：tempArenaInfo 捕获的实时对局，对局结束即收起 -->
              <StackPanel DockPanel.Dock="Top" Margin="{StaticResource SpacingSm}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Border Width="3"
                          Height="12"
                          CornerRadius="1"
                          Background="{StaticResource PrimaryBrush}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="当前对局"
                             Style="{StaticResource SecondaryTextStyle}"
                             Foreground="{StaticResource PrimaryFgBrush}"
                             FontWeight="SemiBold"
                             Margin="6,0,0,0" />
                </StackPanel>
                <ListBox x:Name="LiveBattlesList"
                         ItemsSource="{Binding LiveBattles}"
                         SelectedItem="{Binding SelectedLiveBattle}"
                         ItemTemplate="{StaticResource BattleItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MaxHeight="220"
                         Visibility="{Binding HasLiveBattles, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="当前没有正在进行的对局"
                           Style="{StaticResource EmptyHintTextStyle}"
                           Margin="0,2,0,0"
                           Visibility="{Binding HasLiveBattles, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
              </StackPanel>

              <!-- 分隔线：发丝线 -->
              <Border DockPanel.Dock="Top"
                      Height="1"
                      Background="{StaticResource HairlineBrush}"
                      Margin="{StaticResource SpacingSm}" />

              <!-- 历史对局区：带模式与日期筛选 -->
              <StackPanel DockPanel.Dock="Top" Margin="{StaticResource SpacingSm}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Border Width="3"
                          Height="12"
                          CornerRadius="1"
                          Background="{StaticResource HiddenBrush}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="历史对局"
                             Style="{StaticResource SecondaryTextStyle}"
                             Margin="6,0,0,0" />
                  <ComboBox FontSize="11"
                            MinWidth="72"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            SelectedIndex="{Binding HistoryBattleTypeFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="全部模式" />
                    <ComboBoxItem Content="随机" />
                    <ComboBoxItem Content="排位" />
                    <ComboBoxItem Content="联合作战" />
                    <ComboBoxItem Content="其他" />
                  </ComboBox>
                  <ComboBox FontSize="11"
                            MinWidth="64"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            SelectedIndex="{Binding HistoryDaysFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="全部时间" />
                    <ComboBoxItem Content="近1天" />
                    <ComboBoxItem Content="近7天" />
                    <ComboBoxItem Content="近30天" />
                  </ComboBox>
                </StackPanel>
              </StackPanel>
              <ListBox ItemsSource="{Binding HistoryBattles}"
                       SelectedItem="{Binding SelectedHistoryBattle}"
                       ItemTemplate="{StaticResource BattleItemTemplate}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
          </Border>

          <!-- 右栏 -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 预测对照仪表：单行紧凑布局，胜率读数带置信度与三态对照结论、副标题与重算按钮 -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
              <Grid Margin="{StaticResource SpacingMd}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 胜率读数带模型置信度与对照结论，结论直接以颜色表达语义，省去标签层 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding PredictedWinrateText}"
                             Style="{StaticResource DisplayTextStyle}"
                             Foreground="{StaticResource AllyBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ModelConfidenceText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             ToolTip="模型置信度：预测概率偏离五五开的程度"
                             VerticalAlignment="Bottom"
                             Margin="8,0,0,4" />
                  <!-- 对照结论三态着色：正确绿、错误红、待对照与平局灰 -->
                  <TextBlock Text="{Binding PredictionVerdict}"
                             VerticalAlignment="Center"
                             Margin="14,0,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
                        <Setter Property="Foreground" Value="{StaticResource HiddenBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding PredictionVerdict}" Value="预测正确">
                            <Setter Property="Foreground" Value="{StaticResource WinBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding PredictionVerdict}" Value="预测错误">
                            <Setter Property="Foreground" Value="{StaticResource LossBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>

                <!-- 副标题独占中栏，顶部倒计时行 + 底部对局信息。模型前缀已并入倒计时逻辑 -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="24,0,0,2">
                  <!-- 赛前数据刷新倒计时：循环运行时可见，主色提醒读数在收敛，
                       连续无进展停止时转危险色 -->
                  <TextBlock Text="{Binding CountdownText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             Foreground="{Binding CountdownBrushKey, Converter={StaticResource BrushKeyConverter}}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding CountdownText, TargetNullValue=正在在线补齐玩家数据}"
                             Visibility="{Binding CountdownText, Converter={StaticResource EmptyStringToCollapsedConverter}}" />
                  <TextBlock Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,2,0,0">
                    <Run Text="{Binding BattleSubtitle, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>

                <!-- 重算胜率按钮 -->
                <Button Grid.Column="2"
                        Content="重算胜率"
                        Command="{Binding RecomputePredictionCommand}"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- 双方名单：阵营色顶边条 + 底部对照。禁横向滚动，列宽压缩适应视口 -->
            <Grid Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- 友方 -->
              <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Height="3"
                          Background="{StaticResource AllyBrush}"
                          CornerRadius="16,16,0,0" />
                  <DockPanel Grid.Row="1">
                    <!-- 队名与平均数据同一行，ApeRadar 式头部 -->
                    <Grid DockPanel.Dock="Top" Margin="{StaticResource SpacingSm}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="友方"
                                 Style="{StaticResource HeadingTextStyle}"
                                 Foreground="{StaticResource AllyBrush}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                        <TextBlock Text="平均数据: "
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding AllySummaryText}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Allies}" HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False">
                      <DataGrid.RowStyle>
                        <!-- 行背景按水平分档：海王紫底、猴子红底，普通透明。
                             直接挂 RowStyle 而非资源字典隐式样式，挂载点明确，避免优先级歧义 -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                          <Setter Property="Background"
                                  Value="{Binding Converter={StaticResource RowBackgroundBrushKeyConverter}}" />
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </DataGrid.RowStyle>
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="玩家" Width="160" MaxWidth="240">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <!-- 军团标签按分档着色：紫会用 UnicumBrush，强会用 PrimaryFgBrush，
                                       默认主文本色。无标签时整块收起，由昵称块独占。 -->
                                  <TextBlock Text="{Binding ClanTagText}"
                                             ToolTip="{Binding ClanToolTip}"
                                             TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding HasClanTag}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding ClanTagBrushKey}" Value="UnicumBrush">
                                            <Setter Property="Foreground" Value="{StaticResource UnicumBrush}" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding ClanTagBrushKey}" Value="PrimaryFgBrush">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryFgBrush}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <TextBlock Text="{Binding PlayerNameText}"
                                             TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding HasClanTag}" Value="True">
                                            <Setter Property="Margin" Value="4,0,0,0" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </StackPanel>
                                <!-- 船名行：舰种缩写、等级、船名后跟小队色块 -->
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding ShipLineText}"
                                             Style="{StaticResource SecondaryTextStyle}"
                                             TextTrimming="CharacterEllipsis" />
                                  <Border VerticalAlignment="Center" Margin="4,0,0,0"
                                          Width="7" Height="7" CornerRadius="2"
                                          ToolTip="小队"
                                          Background="{Binding DivisionSize, Converter={StaticResource DivisionBadgeBrushConverter}}" />
                                </StackPanel>
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="账号" Width="Auto" MinWidth="86">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding BattlesBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding WinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding WinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding AvgDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding AvgDamageBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="加权" Width="*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding WeightedWinrateText}"
                                         Style="{StaticResource BodyTextStyle}"
                                         Foreground="{Binding WeightedWinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="舰种" Width="*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ClassBattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ClassWinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ClassMasteryBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ClassDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="单船" Width="*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ShipBattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ShipWinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ShipWinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ShipDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ShipDamageBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Grid>
              </Border>

              <!-- 敌方 -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Height="3"
                          Background="{StaticResource EnemyBrush}"
                          CornerRadius="16,16,0,0" />
                  <DockPanel Grid.Row="1">
                    <!-- 队名与平均数据同一行，ApeRadar 式头部 -->
                    <Grid DockPanel.Dock="Top" Margin="{StaticResource SpacingSm}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="敌方"
                                 Style="{StaticResource HeadingTextStyle}"
                                 Foreground="{StaticResource EnemyBrush}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                        <TextBlock Text="平均数据: "
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding EnemySummaryText}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Enemies}" HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False">
                      <DataGrid.RowStyle>
                        <!-- 行背景按水平分档：与友方同一套样式 -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                          <Setter Property="Background"
                                  Value="{Binding Converter={StaticResource RowBackgroundBrushKeyConverter}}" />
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </DataGrid.RowStyle>
                      <DataGrid.Columns>
                        <DataGridTemplateColumn Header="玩家" Width="160" MaxWidth="240">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <!-- 军团标签按分档着色：紫会用 UnicumBrush，强会用 PrimaryFgBrush，
                                       默认主文本色。无标签时整块收起，由昵称块独占。 -->
                                  <TextBlock Text="{Binding ClanTagText}"
                                             ToolTip="{Binding ClanToolTip}"
                                             TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding HasClanTag}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding ClanTagBrushKey}" Value="UnicumBrush">
                                            <Setter Property="Foreground" Value="{StaticResource UnicumBrush}" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding ClanTagBrushKey}" Value="PrimaryFgBrush">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryFgBrush}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <TextBlock Text="{Binding PlayerNameText}"
                                             TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding HasClanTag}" Value="True">
                                            <Setter Property="Margin" Value="4,0,0,0" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </StackPanel>
                                <!-- 船名行：舰种缩写、等级、船名后跟小队色块 -->
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding ShipLineText}"
                                             Style="{StaticResource SecondaryTextStyle}"
                                             TextTrimming="CharacterEllipsis" />
                                  <Border VerticalAlignment="Center" Margin="4,0,0,0"
                                          Width="7" Height="7" CornerRadius="2"
                                          ToolTip="小队"
                                          Background="{Binding DivisionSize, Converter={StaticResource DivisionBadgeBrushConverter}}" />
                                </StackPanel>
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="账号" Width="Auto" MinWidth="86">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding BattlesBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding WinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding WinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding AvgDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding AvgDamageBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="加权" Width="*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding WeightedWinrateText}"
                                         Style="{StaticResource BodyTextStyle}"
                                         Foreground="{Binding WeightedWinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center" />
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="舰种" Width="*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ClassBattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ClassWinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ClassMasteryBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ClassDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="单船" Width="*">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ShipBattlesText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ShipWinrateText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ShipWinrateBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding ShipDamageText}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{Binding ShipDamageBrushKey, Converter={StaticResource BrushKeyConverter}}"
                                           TextAlignment="Right" />
                              </StackPanel>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <!-- 运行日志：时间 加 级别 加 消息三列，级别着色，新条目自动滚底 -->
      <TabItem Header="运行日志">
        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="运行日志"
                       Style="{StaticResource HeadingTextStyle}"
                       Margin="{StaticResource SpacingSm}" />

            <ListBox x:Name="LogEntriesList"
                     Grid.Row="1"
                     ItemsSource="{Binding Logs.Entries}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="{StaticResource SpacingSm}"
                     SelectionMode="Single"
                     ScrollViewer.ScrollChanged="OnLogListScrollChanged">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="Padding" Value="0,4" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource HairlineBrush}"
                          BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Level, Converter={StaticResource LogLevelTextConverter}}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 Foreground="{Binding Level, Converter={StaticResource LogLevelBrushKeyConverter}}"
                                 VerticalAlignment="Top" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding Message}"
                                 Style="{StaticResource SecondaryTextStyle}"
                                 Foreground="{Binding Level, Converter={StaticResource LogLevelBrushKeyConverter}}"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Top" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </TabItem>

      <!-- 校准统计 -->
      <TabItem Header="校准统计">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel DataContext="{Binding Calibration}">

            <!-- 指标卡 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
                <StackPanel>
                  <TextBlock Text="Brier 分数" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Text="{Binding BrierScoreText}"
                             Style="{StaticResource TitleTextStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock Text="{Binding BrierComparisonText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
                <StackPanel>
                  <TextBlock Text="对数损失" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Text="{Binding LogLossText}"
                             Style="{StaticResource TitleTextStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock Text="{Binding LogLossComparisonText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
                <StackPanel>
                  <TextBlock Text="判别准确率" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Text="{Binding AccuracyText}"
                             Style="{StaticResource TitleTextStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock Text="预测方向与结果一致的比例"
                             Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
                <StackPanel>
                  <TextBlock Text="样本规模" Style="{StaticResource SecondaryTextStyle}" />
                  <TextBlock Text="{Binding SampleCount}"
                             Style="{StaticResource TitleTextStyle}"
                             Margin="0,6,0,0" />
                  <TextBlock Text="{Binding SampleCountText}"
                             Style="{StaticResource SecondaryTextStyle}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- 结论与刷新 -->
            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingSm}" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding QualityText}"
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="重新统计"
                        Command="{Binding RefreshCommand}" />
              </Grid>
            </Border>

            <!-- 校准曲线 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="校准曲线"
                           Style="{StaticResource HeadingTextStyle}"
                           Margin="{StaticResource SpacingSm}" />
                <TextBlock DockPanel.Dock="Top"
                           Text="柱长代表该概率区间的实际胜率，与预测均值越接近越好。柱为红色表示偏差超过 0.1。"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="8,0,8,8"
                           TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Buckets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="70" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding RangeText}"
                                   Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center" />

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                          <Border Height="18"
                                  Width="{Binding BarWidth}"
                                  HorizontalAlignment="Left"
                                  CornerRadius="3"
                                  Background="{Binding BarBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="样本 " Style="{StaticResource SecondaryTextStyle}" />
                          <TextBlock Text="{Binding SampleCountText}"
                                     Style="{StaticResource SecondaryTextStyle}"
                                     Width="46"
                                     TextAlignment="Right" />
                          <TextBlock Text="  实际 " Style="{StaticResource SecondaryTextStyle}" />
                          <TextBlock Text="{Binding ActualWinrateText}"
                                     Style="{StaticResource SecondaryTextStyle}"
                                     Width="52"
                                     TextAlignment="Right" />
                          <TextBlock Text="  预测 " Style="{StaticResource SecondaryTextStyle}" />
                          <TextBlock Text="{Binding PredictedMeanText}"
                                     Style="{StaticResource SecondaryTextStyle}"
                                     Width="46"
                                     TextAlignment="Right" />
                          <TextBlock Text="  偏差 " Style="{StaticResource SecondaryTextStyle}" />
                          <TextBlock Text="{Binding CalibrationErrorText}"
                                     Style="{StaticResource SecondaryTextStyle}"
                                     Width="60"
                                     TextAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="4,8,0,0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 设置 -->
      <TabItem Header="设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel DataContext="{Binding Settings}" MaxWidth="900" HorizontalAlignment="Left">

            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}">
              <StackPanel>
                <TextBlock Text="路径配置" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,4" />
                <TextBlock Text="路径在启动时被各服务读取，修改后需保存才会生效。"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏目录"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,8,8" />
                  <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="探测"
                            Command="{Binding DetectGamePathCommand}" />
                    <Button Content="浏览"
                            Command="{Binding BrowseGamePathCommand}" Margin="6,0,0,0" />
                  </StackPanel>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="数据库路径"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,8,8" />
                  <Button Grid.Row="1" Grid.Column="2" Content="浏览"
                          Command="{Binding BrowseDatabasePathCommand}" Margin="0,0,0,8" />

                  <!-- replayshark、游戏数据与 constants 三个路径已内置自动探测，
                       不再暴露给用户。高级需求直接编辑 config.json。 -->

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="模型路径"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,8,0" />
                  <Button Grid.Row="2" Grid.Column="2" Content="浏览"
                          Command="{Binding BrowseModelPathCommand}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="外观" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,4" />
                <TextBlock Text="切换立即生效，保存后下次启动沿用。"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="主题"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox Grid.Row="0" Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                            SelectedIndex="{Binding ThemeIndex, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource SpacingLg}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="模型与观测" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="模型版本"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="0" Grid.Column="1" MaxWidth="360" HorizontalAlignment="Left"
                           Text="{Binding ModelVersion, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,0,8" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="WG API 应用 ID"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  <TextBox Grid.Row="1" Grid.Column="1" MaxWidth="360" HorizontalAlignment="Left"
                           Text="{Binding WgApplicationId, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,0,8" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="轮询间隔秒"
                             Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Grid.Row="2" Grid.Column="1" MaxWidth="120" HorizontalAlignment="Left"
                           Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="保存并应用" Command="{Binding SaveCommand}" />
              <TextBlock Text="{Binding StatusMessage}"
                         Style="{StaticResource SecondaryTextStyle}"
                         VerticalAlignment="Center"
                         Margin="12,0,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!-- 品牌落款：图标取自 Resources/Images/AppIcon.png，与窗口及可执行文件同源 -->
            <StackPanel Orientation="Horizontal" Margin="0,28,0,4">
              <Image Source="pack://application:,,,/WowsBattleIntel.Client;component/Resources/Images/AppIcon.png"
                     Width="64" Height="64"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="wows-battle-intel" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Text="{Binding VersionText}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
